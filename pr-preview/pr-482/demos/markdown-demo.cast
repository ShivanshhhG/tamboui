[0.000000, "o", "\u001b[2J\u001b[1;1H\u001b[0m╭ markdown-demo ───────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[2;1H│\u001b[0;97;1;7mTamboUI Markdown\u001b[0m                                                                                                      │\u001b[3;1H│\u001b[0;37m══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════\u001b[0m│\u001b[4;1H│                                                                                                                      │\u001b[5;1H│Welcome to the \u001b[0;1mmarkdown renderer\u001b[0m demo. This view supports a useful subset of CommonMark and the \u001b[0;3mmost-used\u001b[0m GFM         │\u001b[6;1H│extensions.                                                                                                           │\u001b[7;1H│                                                                                                                      │\u001b[8;1H│\u001b[0;33;1mInline styling\u001b[0m                                                                                                        │\u001b[9;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[10;1H│                                                                                                                      │\u001b[11;1H│You can use \u001b[0;1mbold\u001b[0m, \u001b[0;3mitalic\u001b[0m, \u001b[0;9mstrikethrough\u001b[0m, \u001b[0;37;2minline code\u001b[0m, and \u001b]8;;https://github.com/tamboui/tamboui\u001b\\\u001b[0;34;4mhyperlinks\u001b]8;;\u001b\\\u001b[0m.                                                 │\u001b[12;1H│                                                                                                                      │\u001b[13;1H│\u001b[0;33;1mLists\u001b[0m                                                                                                                 │\u001b[14;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[15;1H│                                                                                                                      │\u001b[16;1H│Bullet lists:                                                                                                         │\u001b[17;1H│                                                                                                                      │\u001b[18;1H│\u001b[0;36m• \u001b[0mbuffers are diffed before flush                                                                                     │\u001b[19;1H│\u001b[0;36m• \u001b[0mwidgets render to a single \u001b[0;37;2mBuffer\u001b[0m                                                                                   │\u001b[20;1H│\u001b[0;36m• \u001b[0mthe toolkit is a thin DSL on top                                                                                    │\u001b[21;1H│                                                                                                                      │\u001b[22;1H│Ordered lists:                                                                                                        │\u001b[23;1H│                                                                                                                      │\u001b[24;1H│\u001b[0;36m1. \u001b[0mparse markdown                                                                                                     │\u001b[25;1H│\u001b[0;36m2. \u001b[0mlayout into chunks                                                                                                 │\u001b[26;1H│\u001b[0;36m3. \u001b[0mrender to the buffer                                                                                               │\u001b[27;1H│                                                                                                                      │\u001b[28;1H│GFM task lists:                                                                                                       │\u001b[29;1H│                                                                                                                      │\u001b[30;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mparse CommonMark                                                                                                │\u001b[31;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mhandle GFM tables                                                                                               │\u001b[32;1H│\u001b[0;36m• \u001b[0;37m[ ] \u001b[0madd toolkit DSL element                                                                                         │\u001b[33;1H│                                                                                                                      │\u001b[34;1H│\u001b[0;33;1mTables\u001b[0m                                                                                                                │\u001b[35;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[36;1H│                                                                                                                      │\u001b[37;1H│\u001b[0;1mWidget\u001b[0m                                  \u001b[0;1mStateful\u001b[0m                                \u001b[0;1mModule\u001b[0m                                │\u001b[38;1H│Paragraph                               no                                      tamboui-widgets                       │\u001b[39;1H│Table                                   yes                                     tamboui-widgets                       │\u001b[40;1H╰ j/k scroll · s stream · q quit ──────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
[2.250000, "o", "\u001b[1;1H\u001b[0m╭ markdown-demo ───────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[2;1H│\u001b[0;37m══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════\u001b[0m│\u001b[3;1H│                                                                                                                      │\u001b[4;1H│Welcome to the \u001b[0;1mmarkdown renderer\u001b[0m demo. This view supports a useful subset of CommonMark and the \u001b[0;3mmost-used\u001b[0m GFM         │\u001b[5;1H│extensions.                                                                                                           │\u001b[6;1H│                                                                                                                      │\u001b[7;1H│\u001b[0;33;1mInline styling\u001b[0m                                                                                                        │\u001b[8;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[9;1H│                                                                                                                      │\u001b[10;1H│You can use \u001b[0;1mbold\u001b[0m, \u001b[0;3mitalic\u001b[0m, \u001b[0;9mstrikethrough\u001b[0m, \u001b[0;37;2minline code\u001b[0m, and \u001b]8;;https://github.com/tamboui/tamboui\u001b\\\u001b[0;34;4mhyperlinks\u001b]8;;\u001b\\\u001b[0m.                                                 │\u001b[11;1H│                                                                                                                      │\u001b[12;1H│\u001b[0;33;1mLists\u001b[0m                                                                                                                 │\u001b[13;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[14;1H│                                                                                                                      │\u001b[15;1H│Bullet lists:                                                                                                         │\u001b[16;1H│                                                                                                                      │\u001b[17;1H│\u001b[0;36m• \u001b[0mbuffers are diffed before flush                                                                                     │\u001b[18;1H│\u001b[0;36m• \u001b[0mwidgets render to a single \u001b[0;37;2mBuffer\u001b[0m                                                                                   │\u001b[19;1H│\u001b[0;36m• \u001b[0mthe toolkit is a thin DSL on top                                                                                    │\u001b[20;1H│                                                                                                                      │\u001b[21;1H│Ordered lists:                                                                                                        │\u001b[22;1H│                                                                                                                      │\u001b[23;1H│\u001b[0;36m1. \u001b[0mparse markdown                                                                                                     │\u001b[24;1H│\u001b[0;36m2. \u001b[0mlayout into chunks                                                                                                 │\u001b[25;1H│\u001b[0;36m3. \u001b[0mrender to the buffer                                                                                               │\u001b[26;1H│                                                                                                                      │\u001b[27;1H│GFM task lists:                                                                                                       │\u001b[28;1H│                                                                                                                      │\u001b[29;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mparse CommonMark                                                                                                │\u001b[30;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mhandle GFM tables                                                                                               │\u001b[31;1H│\u001b[0;36m• \u001b[0;37m[ ] \u001b[0madd toolkit DSL element                                                                                         │\u001b[32;1H│                                                                                                                      │\u001b[33;1H│\u001b[0;33;1mTables\u001b[0m                                                                                                                │\u001b[34;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[35;1H│                                                                                                                      │\u001b[36;1H│\u001b[0;1mWidget\u001b[0m                                  \u001b[0;1mStateful\u001b[0m                                \u001b[0;1mModule\u001b[0m                                │\u001b[37;1H│Paragraph                               no                                      tamboui-widgets                       │\u001b[38;1H│Table                                   yes                                     tamboui-widgets                       │\u001b[39;1H│Markdown                                no                                      tamboui-markdown                      │\u001b[40;1H╰ j/k scroll · s stream · q quit ──────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
